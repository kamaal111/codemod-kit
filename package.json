{
  "name": "@kamaalio/codemod-kit",
  "version": "0.0.1",
  "bugs": "https://github.com/kamaal111/codemod-kit/issues",
  "license": "MIT",
  "author": "Kamaal Farah",
  "repository": "kamaal111/codemod-kit",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rslib build",
    "build:clean": "rm -rf dist tsconfig.tsbuildinfo && pnpm run build",
    "dev": "rslib build --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "husky",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.40.5",
    "@kamaalio/kamaal": "^0.8.0",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "neverthrow": "^8.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@rslib/core": "^0.19.1",
    "@types/node": "^25.0.6",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  }
}
